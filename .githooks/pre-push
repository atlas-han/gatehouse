#!/usr/bin/env bash
#
# pre-push: push 대상 커밋을 gitleaks로 검사하고, 비밀값이 감지되면 push를 차단한다.
#
# 활성화: git config core.hooksPath .githooks
# 우회(긴급 시에만): git push --no-verify

set -uo pipefail

remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

RED=$'\033[1;31m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
RESET=$'\033[0m'

block() {
  {
    echo
    echo "${RED}======================================================================${RESET}"
    echo "${RED} [gitleaks] push 차단: $1${RESET}"
    echo "${RED}======================================================================${RESET}"
    shift
    for line in "$@"; do echo " $line"; done
    echo
  } >&2
  exit 1
}

if ! command -v gitleaks >/dev/null 2>&1; then
  block "gitleaks가 설치되어 있지 않습니다." \
    "설치: brew install gitleaks"
fi

found=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # 원격 브랜치 삭제는 검사할 커밋이 없다
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # 새 브랜치: 원격에 아직 없는 커밋만 검사
    range="$local_sha --not --remotes=$remote"
  else
    range="$remote_sha..$local_sha"
  fi

  echo "${YELLOW}[gitleaks] ${local_ref} -> ${remote_ref} 검사 중...${RESET}" >&2
  if ! gitleaks git --no-banner --redact --verbose --log-level warn --log-opts="$range" . >&2; then
    found=1
  fi
done

if [ "$found" -ne 0 ]; then
  block "커밋에서 비밀값(secret)으로 의심되는 항목이 감지되었습니다." \
    "1. 위 결과에서 File / Line / Commit을 확인하세요." \
    "2. 해당 값을 제거하고 커밋 이력에서도 지우세요 (git commit --amend, git rebase 등)." \
    "3. 이미 노출된 값이라면 즉시 폐기하고 재발급하세요." \
    "4. 오탐이면 해당 줄에 'gitleaks:allow' 주석을 달거나 .gitleaksignore에 fingerprint를 추가하세요."
fi

echo "${GREEN}[gitleaks] 비밀값이 감지되지 않았습니다. push를 진행합니다.${RESET}" >&2
exit 0
